# 复制到 /etc/gaoqiu.env，并设置 root:golfera、权限640；填入数据库密码。
GOLFERA_DB_TYPE=mysql
GOLFERA_MYSQL_HOST=127.0.0.1
GOLFERA_MYSQL_PORT=3306
GOLFERA_MYSQL_USER=gaoqiu
GOLFERA_MYSQL_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
GOLFERA_MYSQL_DATABASE=gaoqiu
GOLFERA_STATIC_DIR=/www/wwwroot/gaoqiu/dist
GOLFERA_BACKUP_DIR=/www/wwwroot/gaoqiu/data/backups
HOST=0.0.0.0
PORT=8088
# 仅全新空库首次启动需要至少12位的初始化管理员密码；已有迁移库不要重新设置。
# GOLFERA_ADMIN_PASSWORD=REPLACE_WITH_INITIAL_ADMIN_PASSWORD
